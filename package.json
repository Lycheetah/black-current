    "phone": "node scripts/witness-phone-layout.mjs",
    "fps": "node scripts/attrib-render-passes.mjs firefox",
    "test:novices": "node scripts/witness-novice-fleet.mjs",
    "test:phone-fitting": "node scripts/witness-phone-fitting.mjs",
    "test:first-fit": "node scripts/witness-first-fit.mjs",
    "test:rookie-balance": "node scripts/witness-rookie-balance.mjs",
    "test:space": "node scripts/witness-space-experience.mjs",
    "test:audio": "node scripts/witness-audio-forge.mjs",
    "test:codex": "node scripts/witness-equipment-codex.mjs",
    "test:supply": "node scripts/witness-quartermaster.mjs",
    "test:journey": "node scripts/witness-accessible-start.mjs",
    "test:hangar": "node scripts/witness-hangar-ui.mjs",
    "test:candidate": "node scripts/witness-release-candidate.mjs",
    "test:progression": "node scripts/witness-progression-path.mjs",
    "test:factions": "node scripts/witness-faction-fleets.mjs",
    "test:boss-scenes": "node scripts/witness-boss-scenes.mjs",
    "test:refinement": "node scripts/witness-refinement.mjs",
    "test:weapon-access": "node scripts/witness-weapon-access.mjs",
    "test:rookie-supplies": "node scripts/witness-rookie-supplies.mjs",
    "test:jelly": "node scripts/witness-jelly-shoals.mjs",
    "test:combat": "node scripts/witness-combat-pass.mjs",
    "test:mounts": "node scripts/witness-mount-progression.mjs",
    "test:wings": "node scripts/witness-enemy-wings.mjs",
    "test:feel": "node scripts/witness-combat-feel.mjs",
    "test:services": "node scripts/witness-service-menus.mjs",
    "test:scaling": "node scripts/witness-combat-scaling.mjs",
    "test:core": "node scripts/regression.mjs core",
    "test:all": "node scripts/regression.mjs all",
    "scan:visual": "node scripts/witness-visual-scan.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
