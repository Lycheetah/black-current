{
  "name": "black-current",
  "version": "2.25.2-rc.32",
  "private": true,
  "description": "Black Current: top-down bubble-tank arcade game. Zero runtime dependencies; Playwright is for the witness tests only.",
  "author": "Mackenzie Conor James Clark",
  "scripts": {
    "serve": "python3 -m http.server 8811",
    "test": "node scripts/regression.mjs --retry ci",
